# ================= PUBLIC WEBSITE (the only thing needed) =================

# Restaurant WhatsApp that receives the orders — the ONLY place to set it.
# Algerian international format, digits only: 213XXXXXXXXX (e.g. 213550123456).
# "0550 12 34 56" or "+213 550 12 34 56" are also accepted and normalized.
# If missing/invalid, the site works but "Confirmer la commande" is disabled.
NEXT_PUBLIC_YAZ_WHATSAPP_NUMBER=213553704181

# Public URL of the site (canonical links, sitemap, social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================= FUTURE BACKEND (leave empty in this version) =================
# The /admin back-office needs a Supabase database. It is OFF unless ALL of these are set
# and YAZ_ADMIN_BACKEND=supabase. The public website never uses them.
# YAZ_ADMIN_BACKEND=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret-never-commit
